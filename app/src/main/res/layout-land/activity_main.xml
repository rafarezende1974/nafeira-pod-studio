<?xml version="1.0" encoding="utf-8"?>
<!-- Variante paisagem/tablet: mesmos IDs do retrato, em duas colunas.
     Coluna esquerda = cartão do episódio + controles redondos;
     coluna direita = cartão dos efeitos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="Pod Estúdio"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_pod_estudio" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Gravação sem limite de tempo"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Abas em controle segmentado arredondado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/tabRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill"
            android:backgroundTint="@color/accent"
            android:text="⏺ Gravar"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill"
            android:backgroundTint="@color/surface_light"
            android:text="📚 Biblioteca"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/pageRecord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <!-- Filho com match_parent + fillViewport: estica até a altura
                 da tela (sem faixa preta embaixo); em tela curta mede o
                 conteúdo e o ScrollView rola normalmente. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Coluna esquerda: episódio + controles -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Título do episódio"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/etTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="@color/surface_light"
                                android:hint="Título do episódio"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="16sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvRec"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_rec_badge"
                                    android:paddingStart="10dp"
                                    android:paddingTop="4dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="4dp"
                                    android:text="● REC"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvTimer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="00:00:00"
                                    android:textColor="@color/text_primary"
                                    android:textSize="52sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Pronto para gravar"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />

                            <br.com.rafarezende.podcaststudio.audio.WaveformView
                                android:id="@+id/waveform"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:layout_marginTop="8dp" />

                            <br.com.rafarezende.podcaststudio.audio.LevelMeterView
                                android:id="@+id/pbLevel"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="-60      -40      -30      -20      -10      -6      -3      0 dB"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Microfone / entrada de áudio"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <Spinner
                                android:id="@+id/spDevice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="@color/surface_light" />
                        </LinearLayout>

                        <!-- Controles redondos -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <Button
                                    android:id="@+id/btnPause"
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/circle_green"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:minHeight="0dp"
                                    android:minWidth="0dp"
                                    android:padding="0dp"
                                    android:text="❚❚"
                                    android:textColor="#0B0B12"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/tvPauseLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Pausar"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="28dp"
                                android:layout_marginEnd="28dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <Button
                                    android:id="@+id/btnRecord"
                                    android:layout_width="84dp"
                                    android:layout_height="84dp"
                                    android:background="@drawable/circle_red"
                                    android:gravity="center"
                                    android:minHeight="0dp"
                                    android:minWidth="0dp"
                                    android:padding="0dp"
                                    android:text="●"
                                    android:textColor="#FFFFFF"
                                    android:textSize="28sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Gravar"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <Button
                                    android:id="@+id/btnStop"
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/circle_green"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:minHeight="0dp"
                                    android:minWidth="0dp"
                                    android:padding="0dp"
                                    android:text="■"
                                    android:textColor="#0B0B12"
                                    android:textSize="20sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Parar"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Coluna direita: efeitos -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Efeitos sonoros — toque pra tocar · segure pra personalizar"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <GridLayout
                                android:id="@+id/gridPads"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_weight="1"
                                android:columnCount="4" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Volume dos efeitos"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />

                                <SeekBar
                                    android:id="@+id/seekFx"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:max="100" />

                                <TextView
                                    android:id="@+id/tvFxVolumePct"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:gravity="center"
                                    android:minWidth="42dp"
                                    android:text="80%"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />

                                <Button
                                    android:id="@+id/btnStopFx"
                                    android:layout_width="wrap_content"
                                    android:layout_height="44dp"
                                    android:backgroundTint="@color/logo_green"
                                    android:text="Parar efeitos"
                                    android:textColor="#0B0B12"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="∞  Gravação ilimitada    •    12 efeitos personalizáveis    •    Áudio de alta qualidade"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/pageLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biblioteca de episódios"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nenhuma gravação ainda. Toque em Gravar para começar."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/lvLibrary"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:divider="@color/surface_light"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
